# Public app origin used for metadata and Inngest function registration.
# On Railway, set INNGEST_SERVE_ORIGIN to the domain whose TLS certificate is active.
NEXT_PUBLIC_APP_URL=https://luminaweb.app
INNGEST_SERVE_ORIGIN=https://luminaweb.app

# Open Sentry SDK DSN: https://{publicKey}@{ingest-host}/v1/ingest
NEXT_PUBLIC_OPEN_SENTRY_DSN=
OPEN_SENTRY_SAMPLE_RATE=1
OPEN_SENTRY_TRACES_SAMPLE_RATE=0.1
